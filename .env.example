# ---- Server ----
PORT=4000

# ---- Mode ----
# MOCK_MODE is the master switch (used only as the default for the two below).
MOCK_MODE=true

# Override each leg independently. The useful combo for tonight, once you've
# funded a Stellar testnet treasury but Amba's contract still isn't deployed:
#   MOCK_STARKNET=true   (simulate the claim event via POST /api/mock/claim)
#   MOCK_STELLAR=false   (execute a REAL signed payout on Stellar testnet)
MOCK_STARKNET=true
MOCK_STELLAR=true

# ---- Postgres ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pollar_bridge

# ---- Starknet ----
STARKNET_RPC_URL=https://starknet-sepolia.public.blastapi.io/rpc/v0_7
STARKNET_VAULT_CONTRACT_ADDRESS=0xREPLACE_WITH_AMBA_DEPLOYED_ADDRESS
# Polling interval in ms used if the RPC provider doesn't support event subscriptions
STARKNET_POLL_INTERVAL_MS=5000

# ---- Stellar ----
STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Treasury account that pays out USDC to beneficiaries (fund via Friendbot)
STELLAR_TREASURY_SECRET=SREPLACE_WITH_TREASURY_SECRET_KEY
STELLAR_TREASURY_PUBLIC=GREPLACE_WITH_TREASURY_PUBLIC_KEY
# Testnet USDC issuer (Circle's testnet USDC issuer on Stellar testnet)
STELLAR_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA

# ---- Pollar ----
POLLAR_API_BASE_URL=https://sandbox.pollar.xyz
POLLAR_API_KEY=REPLACE_WITH_POLLAR_SANDBOX_KEY
